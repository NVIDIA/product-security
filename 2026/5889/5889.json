            "cve": "CVE-2026-65172",
            "cwe": {
                "id": "CWE-862",
                "name": "Missing Authorization"
            },
            "notes": [
                {
                    "category": "summary",
                    "text": "NVIDIA AIStore for Linux and Kubernetes contains a missing authorization vulnerability in the ETL management API where an unauthenticated remote attacker may access ETL information or control existing ETL jobs by sending crafted GET or POST requests to an AIStore proxy.\n\nA successful exploit may lead to information disclosure and unauthorized start or stop operations that affect the integrity and availability of ETL data-processing pipelines.",
                    "title": "Vulnerability description"
                },
                {
                    "category": "details",
                    "text": "data tampering, denial of service, information disclosure",
                    "title": "Impacts"
                },
                {
